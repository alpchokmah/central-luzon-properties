# Set your real HTTPS domain before public launch.
SITE_URL=http://localhost:3000
HOST=127.0.0.1
PORT=3000
# Use a persistent private volume on your hosting provider.
DATA_DIR=./data
# Set a long random secret to enable the protected CSV export endpoint.
LEADS_EXPORT_TOKEN=

# Google Sheets lead sync (optional). Share the sheet with the service account email as Editor.
GOOGLE_SHEETS_ID=
GOOGLE_SHEETS_TAB=Leads
GOOGLE_SHEETS_PARTNERS_TAB=Partners
GOOGLE_SERVICE_ACCOUNT_FILE=
# Prefer this on Vercel (paste the full service-account JSON as one line).
GOOGLE_SERVICE_ACCOUNT_JSON=
